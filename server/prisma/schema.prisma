// ========================================
// PRISMA CLIENT
// ========================================

generator client {
  provider = "prisma-client-js"
}

// ========================================
// DATABASE CONNECTION
// ========================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// ENUMS
// ========================================

// User roles available in DineFlow
enum UserRole {
  CUSTOMER
  CHEF
  WAITER
  INVENTORY_STAFF
  MANAGER
}

// User account status
enum UserStatus {
  ACTIVE
  INACTIVE
}

// Order lifecycle
enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

// Physical restaurant table status
enum TableStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  CLEANING
  DISABLED
}

// Reservation lifecycle
enum ReservationStatus {
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Inventory stock movement type
enum InventoryTransactionType {
  STOCK_IN
  WASTE
  ADJUSTMENT
  CONSUMPTION
}

// Procurement / reorder lifecycle
enum ReorderStatus {
  PENDING
  APPROVED
  REJECTED
  RECEIVED
}

// ========================================
// USER
//
// Represents:
// - Customer
// - Chef
// - Waiter
// - Inventory Staff
// - Manager
// ========================================

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Staff users can have one employee profile
  employee Employee?

  // Customer orders
  orders Order[]

  // Customer table reservations
  reservations Reservation[]

  // Inventory operations performed by user
  inventoryTransactions InventoryTransaction[]

  // Reorder requests created by Inventory Staff
  createdReorderRequests ReorderRequest[] @relation("ReorderCreatedBy")

  // Reorder requests reviewed by Manager
  reviewedReorderRequests ReorderRequest[] @relation("ReorderReviewedBy")

  // Reorder deliveries received by Inventory Staff
  receivedReorderRequests ReorderRequest[] @relation("ReorderReceivedBy")
}

// ========================================
// EMPLOYEE
// Extra staff information
// ========================================

model Employee {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  employeeCode String   @unique
  department   String?
  shift        String?
  joinedAt     DateTime @default(now())

  // Employee belongs to one User
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ========================================
// MENU CATEGORY
//
// Examples:
// Pizza
// Drinks
// Desserts
// ========================================

model MenuCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One category contains many menu items
  items MenuItem[]
}

// ========================================
// MENU ITEM
// Individual restaurant dish
// ========================================

model MenuItem {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  prepTime    Int?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Category relationship
  categoryId Int
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Dish can appear in many orders
  orderItems        OrderItem[]
  // Ingredients required to prepare this dish
  recipeIngredients RecipeIngredient[]
}

// ========================================
// ORDER
// Complete order placed by customer
// ========================================

model Order {
  id     Int         @id @default(autoincrement())
  status OrderStatus @default(PENDING)

  // Backend-calculated order total
  total Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Customer who placed order
  customerId Int
  customer   User @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Dishes inside order
  items OrderItem[]
}

// ========================================
// ORDER ITEM
// One line/dish inside an order
// ========================================

model OrderItem {
  id Int @id @default(autoincrement())

  // Number of units ordered
  quantity Int

  // Price snapshot at time order was placed
  unitPrice Decimal @db.Decimal(10, 2)

  // Parent order
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Ordered menu item
  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
}

// ========================================
// RESTAURANT TABLE
// Physical table inside restaurant
// ========================================

model RestaurantTable {
  id       Int         @id @default(autoincrement())
  number   String      @unique
  capacity Int
  status   TableStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reservation history for this table
  reservations Reservation[]
}

// ========================================
// RESERVATION
// Customer table booking
// ========================================

model Reservation {
  id Int @id @default(autoincrement())

  // Number of guests
  guestCount Int

  // Reservation time window
  startTime DateTime
  endTime   DateTime

  status ReservationStatus @default(CONFIRMED)

  specialRequest String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Customer who booked
  customerId Int
  customer   User @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Reserved table
  tableId Int
  table   RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Restrict)

  // Helps overlap/availability queries
  @@index([tableId, startTime, endTime])
  // Helps customer reservation queries
  @@index([customerId])
}

// ========================================
// INVENTORY ITEM
//
// Examples:
// Mozzarella - kg
// Tomato     - kg
// Milk       - L
// Chicken    - kg
// ========================================

model InventoryItem {
  id Int @id @default(autoincrement())

  // Ingredient/material name
  name String @unique

  // Measurement unit:
  // kg, g, L, ml, pcs, etc.
  unit String

  // Current available quantity
  currentStock Decimal @default(0) @db.Decimal(12, 3)

  // Low-stock threshold
  currentStockMinimumPlaceholder String? @ignore
  minimumStock                   Decimal @default(0) @db.Decimal(12, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Complete stock movement history
  transactions InventoryTransaction[]

  // Procurement/reorder history
  reorderRequests   ReorderRequest[]
  // Recipes that use this inventory item
  recipeIngredients RecipeIngredient[]
}

// ========================================
// INVENTORY TRANSACTION
//
// Audit trail for every stock movement.
// ========================================

model InventoryTransaction {
  id Int @id @default(autoincrement())

  // STOCK_IN / WASTE / ADJUSTMENT
  type InventoryTransactionType

  // Positive magnitude of stock operation
  quantity Decimal @db.Decimal(12, 3)

  // Optional explanation
  note String?

  createdAt DateTime @default(now())

  // Inventory item affected
  inventoryItemId Int
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  // User who performed operation
  performedById Int
  performedBy   User @relation(fields: [performedById], references: [id], onDelete: Restrict)

  @@index([inventoryItemId])
  @@index([performedById])
}

// ========================================
// REORDER REQUEST
//
// Procurement workflow:
//
// Inventory Staff
//      ↓
// PENDING
//      ↓
// Manager
// APPROVED / REJECTED
//      ↓
// Approved delivery arrives
//      ↓
// Inventory Staff
//      ↓
// RECEIVED
//      ↓
// Inventory automatically increases
// ========================================

model ReorderRequest {
  id Int @id @default(autoincrement())

  // Quantity requested from supplier
  quantity Decimal @db.Decimal(12, 3)

  // Optional reason/procurement note
  note String?

  // Current procurement status
  status ReorderStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Manager review timestamp
  reviewedAt DateTime?

  // Physical delivery received timestamp
  receivedAt DateTime?

  // ========================================
  // INVENTORY ITEM
  // ========================================

  inventoryItemId Int
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  // ========================================
  // CREATED BY
  // Inventory Staff who requested stock
  // ========================================

  createdById Int
  createdBy   User @relation("ReorderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // ========================================
  // REVIEWED BY
  // Manager who approved/rejected request
  // ========================================

  reviewedById Int?
  reviewedBy   User? @relation("ReorderReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  // ========================================
  // RECEIVED BY
  // Inventory Staff who received delivery
  // ========================================

  receivedById Int?
  receivedBy   User? @relation("ReorderReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)

  // Useful indexes
  @@index([inventoryItemId])
  @@index([status])
  @@index([createdById])
}

model RecipeIngredient {
  id Int @id @default(autoincrement())

  quantity Decimal @db.Decimal(12, 3)

  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  inventoryItemId Int
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([menuItemId, inventoryItemId])
  @@index([menuItemId])
  @@index([inventoryItemId])
}
